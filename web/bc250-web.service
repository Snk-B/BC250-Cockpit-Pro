[Unit]
Description=BC-250 Cockpit Pro Web Monitor
After=network.target apu-telemetry.service
Wants=apu-telemetry.service

[Service]
Type=simple
User=TELEMETRY_USER
WorkingDirectory=TELEMETRY_WEB_DIR
ExecStart=/usr/bin/python3 TELEMETRY_WEB_DIR/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
