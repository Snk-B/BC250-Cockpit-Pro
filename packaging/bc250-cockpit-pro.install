post_install() {
    echo ":: Probing and loading kernel telemetry modules..."
    modprobe bc250_memory 2>/dev/null || true
    modprobe bc250_vrm 2>/dev/null || true
    modprobe nct6687 2>/dev/null || true

    systemctl daemon-reload
    echo ":: Enabling and starting AMD BC-250 telemetry services..."
    systemctl enable --now apu-telemetry.service || true
    systemctl enable --now bc250-web.service || true
    systemctl enable --now bc250-memory.service || true
    echo ":: BC-250 Cockpit Pro installed successfully!"
    echo ":: Web Dashboard: http://localhost:8090/"
    echo ":: KDE Plasma 6 Widget: Add 'BC-250 Cockpit Pro' to your desktop or panel."
}

post_upgrade() {
    echo ":: Probing and loading kernel telemetry modules..."
    modprobe bc250_memory 2>/dev/null || true
    modprobe bc250_vrm 2>/dev/null || true
    modprobe nct6687 2>/dev/null || true

    systemctl daemon-reload
    echo ":: Restarting AMD BC-250 telemetry services..."
    systemctl try-restart apu-telemetry.service || true
    systemctl try-restart bc250-web.service || true
    systemctl try-restart bc250-memory.service || true
    echo ":: BC-250 Cockpit Pro updated successfully!"
}

pre_remove() {
    echo ":: Stopping and disabling AMD BC-250 telemetry services..."
    systemctl stop apu-telemetry.service || true
    systemctl disable apu-telemetry.service || true
    systemctl stop bc250-web.service || true
    systemctl disable bc250-web.service || true
    systemctl stop bc250-memory.service || true
    systemctl disable bc250-memory.service || true
}

post_remove() {
    systemctl daemon-reload
    echo ":: BC-250 Cockpit Pro removed."
}
