[Unit]
Description=AMD BC-250 Titanium Studio Web Cockpit
After=network.target apu-telemetry.service
Wants=apu-telemetry.service

[Service]
Type=simple
WorkingDirectory=/usr/share/bc250-cockpit-pro/web
ExecStart=/usr/bin/python3 /usr/share/bc250-cockpit-pro/web/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
